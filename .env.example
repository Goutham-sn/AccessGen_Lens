# Copy to .env and fill in every value marked CHANGE_ME.
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Backend
PORT=3001
NODE_ENV=development
# Only used when running the backend outside Docker; compose builds its own.
DATABASE_URL=postgresql://accessgen:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/accessgen_lens
REDIS_URL=redis://localhost:6380

# Postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO (local S3). Also used as the MinIO root user and password.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=accessgen-lens
MINIO_USE_SSL=false

# Web App URL (for CORS)
WEB_APP_URL=http://localhost:5173

# Extension
EXTENSION_ID=your_local_extension_id_here
